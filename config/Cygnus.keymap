#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    // "hold-preferred": the hold (layer switch) engages the instant ANY other key
    // is pressed while the thumb key is held -- it does not wait for that key to
    // be released (as "balanced" does) nor for the tapping term (as the default
    // "tap-preferred" does). This is the most reliable flavor for a thumb layer
    // key that leaks SPACE.
    flavor = "hold-preferred";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        mouse_left {
            bindings = <&mkp MB1>;
            key-positions = <21 22>;
        };

        mouse_right {
            bindings = <&mkp MB2>;
            key-positions = <22 23>;
        };

        single_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <16 15>;
        };

        double_quote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <15 14>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 6 ESC  &kp Q         &kp W           &kp E            &kp R     &kp T                                       &kp Y        &kp U  &kp I      &kp O    &kp P            &kp BSPC
&kp TAB    &kp A         &kp S           &kp D            &kp F     &kp G        &mkp MCLK      &kp UP_ARROW    &kp H        &kp J  &kp K      &kp L    &lt 5 SEMICOLON  &kp ENTER
&kp LSHFT  &kp Z         &kp X           &kp C            &kp V     &kp B        &kp DELETE     &kp DOWN_ARROW  &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH         &kp RSHFT
&kp LCTRL  &kp LEFT_ALT  &kp LEFT_ARROW  &kp RIGHT_ARROW  &kp LGUI  &lt 1 SPACE  &lt 2 SPACE    &lt 2 SPACE     &lt 1 SPACE                             &trans           &trans
            >;

            sensor-bindings = <&ROTATE SCRL_LEFT SCRL_RIGHT>;
        };

        SYMBOL {
            bindings = <
&trans  &kp EXCLAMATION  &kp AT       &kp PIPE       &kp GRAVE          &kp PIPE                         &kp PLUS   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EXCLAMATION  &kp SEMICOLON  &trans
&trans  &kp PERCENT      &kp HASH     &kp AMPERSAND  &kp SINGLE_QUOTE   &kp SLASH      &trans    &trans  &kp MINUS  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp QUESTION     &kp COLON      &trans
&trans  &kp ASTRK        &kp INT_YEN  &kp CARET      &kp DOUBLE_QUOTES  &kp BACKSLASH  &trans    &trans  &kp EQUAL  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans           &trans         &trans
&trans  &trans           &trans       &trans         &trans             &trans         &trans    &trans  &trans                                                                   &trans         &trans
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        NUM {
            bindings = <
&trans  &trans      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans                             &kp SLASH     &kp MINUS  &kp PERCENT  &trans  &trans  &trans
&trans  &kp PERIOD  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_NUMBER_0  &trans    &trans  &kp ASTERISK  &kp PLUS   &kp EQUAL    &trans  &trans  &trans
&trans  &trans      &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans           &trans    &trans  &trans        &trans     &trans       &trans  &trans  &trans
&trans  &trans      &trans           &trans           &trans           &trans           &trans    &trans  &trans                                        &trans  &trans
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        ARROW {
            bindings = <
&trans  &kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                                       &trans  &trans    &trans    &trans  &trans  &trans
&trans  &kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans    &kp LG(C_BRIGHTNESS_INC)  &trans  &mkp MB1  &mkp MB2  &trans  &trans  &trans
&trans  &kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans    &kp C_BRIGHTNESS_DEC      &trans  &trans    &trans    &trans  &trans  &trans
&trans  &trans          &trans                  &trans          &trans                   &trans   &trans    &trans                    &trans                              &trans  &trans
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        MOUSE {
            bindings = <
&trans  &trans       &trans  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LC(R)                      &kp LC(R)  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &trans  &trans       &trans
&trans  &lt 5 SPACE  &trans  &mkp MB1         &mkp MB2           &mkp MB3   &mkp MB3    &trans  &mkp MB3   &mkp MB1         &mkp MB2           &trans  &lt 5 SPACE  &trans
&trans  &trans       &trans  &trans           &trans             &trans     &trans      &trans  &trans     &mkp MB4         &mkp MB5           &trans  &trans       &trans
&trans  &trans       &trans  &trans           &trans             &trans     &trans      &trans  &trans                                                 &trans       &trans
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans          &kp UP_ARROW    &trans           &trans                                  &kp C_VOLUME_UP    &trans    &trans    &trans  &trans  &trans
&trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans    &kp C_BRIGHTNESS_INC  &kp C_VOLUME_DOWN  &mkp MB1  &mkp MB2  &trans  &trans  &trans
&trans  &trans  &trans          &trans          &trans           &trans  &trans    &kp C_BRIGHTNESS_DEC  &kp K_MUTE         &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans          &trans          &trans           &trans  &trans    &trans                &trans                                         &trans  &trans
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans        &trans        &trans        &trans                       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
&trans  &trans  &trans        &trans        &trans        &trans     &trans    &trans  &trans        &trans        &trans        &trans        &trans          &trans
&trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kt KP_N4  &trans    &trans  &trans        &trans        &trans        &trans        &bt BT_CLR      &trans
&trans  &trans  &trans        &trans        &trans        &trans     &trans    &trans  &trans                                                  &bt BT_CLR_ALL  &trans
            >;
        };
    };
};
